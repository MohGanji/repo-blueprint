{
  "folderRoles": {
    "apps": "app",
    "app": "app",
    "clients": "app",
    "services": "service",
    "service": "service",
    "servers": "service",
    "packages": "library",
    "libs": "library",
    "lib": "library",
    "shared": "library"
  },
  "sdkDirs": [
    "sdk",
    "client",
    "clients",
    "api-client"
