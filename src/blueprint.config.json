    "*.config.js",
    "*.config.mjs",
    "*.config.cjs",
    ".*rc.js",
    ".*rc.cjs",
    ".*rc.mjs"
  ],
  "frameworkLoaded": [
    "*.entity.ts",
    "*.migration.ts",
    "*.seed.ts",
